APP_ENV=development
# Set a unique local value in .env. Production must not use an empty,
# development-default, or placeholder SECRET_KEY.
SECRET_KEY=
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=false
# Optional; defaults to instance/logs/app.log when LOG_FILE_ENABLED=true
LOG_FILE_PATH=
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUP_COUNT=5

FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# optional: relative paths resolve from the project root
DATABASE_PATH=data/students_v2.db

# Browser session settings. Production enables secure cookies in app config.
SESSION_COOKIE_NAME=student_v2_session
PERMANENT_SESSION_LIFETIME_SECONDS=3600

# Optional local bootstrap users. Password values must be supplied explicitly
# in a local .env when enabled; do not commit real passwords.
BOOTSTRAP_DEFAULT_USERS_ENABLED=false
BOOTSTRAP_VIEWER_USERNAME=viewer
BOOTSTRAP_VIEWER_PASSWORD=
BOOTSTRAP_STAFF_USERNAME=staff
BOOTSTRAP_STAFF_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# reserved for future phases
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001

# AI Chat configuration (all values must come from environment)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_THINKING=false
DEEPSEEK_TRUST_ENV=false
DEEPSEEK_REASONING_EFFORT=high
AI_MAX_TOOL_ROUNDS=10
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_MESSAGE_LENGTH=4000
AI_CONFIRMATION_TOKEN_TTL_SECONDS=120