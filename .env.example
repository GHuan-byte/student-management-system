APP_ENV=development
SECRET_KEY=
LOG_LEVEL=INFO

FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# optional: relative paths resolve from the project root
DATABASE_PATH=data/students_v2.db

# reserved for future phases
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001

# AI Chat configuration (all values must come from environment)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_THINKING=false
DEEPSEEK_TRUST_ENV=false
DEEPSEEK_REASONING_EFFORT=high
AI_MAX_TOOL_ROUNDS=10
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_MESSAGE_LENGTH=4000
AI_CONFIRMATION_TOKEN_TTL_SECONDS=120
